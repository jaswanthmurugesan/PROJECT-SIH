# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATES
# Copy this file to .env and update with your actual values
# =============================================================================

# =============================================================================
# OPTION 1: LOCAL MONGODB (MongoDB running on your machine)
# =============================================================================
# Uncomment and use this for local development:
# MONGODB_URI=mongodb://localhost:27017/learning-path-generator

# If you have authentication enabled on local MongoDB:
# MONGODB_URI=mongodb://username:password@localhost:27017/learning-path-generator

# If using MongoDB with custom port:
# MONGODB_URI=mongodb://localhost:27018/learning-path-generator

# =============================================================================
# OPTION 2: MONGODB ATLAS (Cloud cluster)
# =============================================================================
# Uncomment and update with your Atlas connection string:
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/learning-path-generator?retryWrites=true&w=majority

# Atlas with specific region (example):
# MONGODB_URI=mongodb+srv://username:password@cluster0.aws-region.mongodb.net/learning-path-generator?retryWrites=true&w=majority

# =============================================================================
# CURRENT ACTIVE CONNECTION (UPDATE THIS LINE)
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/learning-path-generator

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5000
NODE_ENV=development

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:5173

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate a strong JWT secret (at least 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-complex-for-production

# =============================================================================
# MONGODB ATLAS SETUP INSTRUCTIONS
# =============================================================================
# 1. Go to https://cloud.mongodb.com/
# 2. Create a new project or select existing
# 3. Create a new cluster (M0 is free tier)
# 4. Create a database user:
#    - Database Access → Add New Database User
#    - Authentication Method: Password
#    - Username: your-username
#    - Password: your-password (generate strong password)
#    - Database User Privileges: Atlas admin or Read and write to any database
# 5. Configure network access:
#    - Network Access → Add IP Address
#    - Either add your current IP or use 0.0.0.0/0 for development (not recommended for production)
# 6. Get connection string:
#    - Clusters → Connect → Connect your application
#    - Driver: Node.js, Version: 4.1 or later
#    - Copy the connection string
#    - Replace <password> with your actual password
#    - Replace <dbname> with: learning-path-generator

# =============================================================================
# LOCAL MONGODB SETUP INSTRUCTIONS
# =============================================================================
# 1. Download MongoDB Community Server: https://www.mongodb.com/download-center/community
# 2. Install MongoDB on your system
# 3. Start MongoDB service:
#    - Windows: Start "MongoDB" service from Services app
#    - macOS: brew services start mongodb-community
#    - Linux: sudo systemctl start mongod
# 4. Verify MongoDB is running:
#    - Open command line and run: mongo (or mongosh for newer versions)
#    - You should see MongoDB shell prompt
# 5. Use the local URI: mongodb://localhost:27017/learning-path-generator

# =============================================================================
# TROUBLESHOOTING TIPS
# =============================================================================
# If you see "buffering timed out" errors:
# 1. Check if MongoDB is running (local) or accessible (Atlas)
# 2. Verify your connection string is correct
# 3. For Atlas: Ensure your IP is whitelisted
# 4. For Atlas: Check username/password are correct
# 5. Check firewall settings
# 6. Try increasing timeout values in the connection options